# Only send application files and dependencies to the image builder.
**
!Dockerfile
!.dockerignore
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/**
!frontend/
!frontend/**

**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/.DS_Store
**/node_modules/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
