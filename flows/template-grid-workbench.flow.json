{
  "baseDir": "..",
  "outDir": "../.selfcheck/template-grid-hotfix/flow",
  "waitMs": 1500,
  "flows": [{
    "name": "确认方案出模板与网格、刷新恢复、新建隔离",
    "url": "http://127.0.0.1:8960/playground/pages/workbench.html",
    "steps": [
      { "click": "#btn-new-session" },
      { "type": "#chat-input", "text": "生成A机房最近7天的能耗报表，四个板块：总耗电指标卡、每日耗电趋势图、设备耗电排名表、PUE指标卡。" },
      { "click": "#btn-send" },
      { "waitFor": ".plan-confirm", "timeout": 180000 },
      { "assertHidden": ".template-design" },
      { "click": ".plan-confirm" },
      { "waitFor": ".template-grid .rg-region", "timeout": 30000 },
      { "assertCount": ".template-grid .rg-region", "count": 4, "op": "===" },
      { "assertVisible": ".rg-gridlines" },
      { "assertVisible": ".rg-handle[data-rg-handle='se']" },
      { "assertCount": ".template-region[data-template-region-status='bound']", "count": 3, "op": "===" },
      { "assertCount": ".template-region[data-template-region-status='placeholder']", "count": 1, "op": "===" },
      { "assertText": "模拟数据" },
      { "assertText": "口径待核实" },
      { "assertHidden": ".plan-confirm" },
      { "screenshot": "01-template-and-grid" },
      { "eval": "location.reload(), true" },
      { "waitFor": ".template-grid .rg-region", "timeout": 15000 },
      { "assertCount": ".template-grid .rg-region", "count": 4, "op": "===" },
      { "screenshot": "02-refresh-restored" },
      { "click": "#btn-new-session" },
      { "assertHidden": ".template-design" },
      { "assertHidden": ".template-grid" }
    ]
  }]
}
