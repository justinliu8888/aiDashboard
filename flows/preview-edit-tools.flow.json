{
  "outDir": "../.selfcheck/flow-edit-tools",
  "waitMs": 1500,
  "timeout": 180000,
  "ignore": ["modao.cc"],
  "flows": [
    {
      "name": "预览-标题区不重复渲染+编辑入口按状态显隐",
      "url": "http://127.0.0.1:8000/playground/pages/workbench.html",
      "continueOnError": false,
      "steps": [
        { "wait": 2000 },
        { "click": "#btn-new-session" },
        { "wait": 500 },
        {
          "type": "#chat-input",
          "text": "生成 A 机房昨日能耗日报，包含总耗电、设备排名和趋势分析"
        },
        { "press": "Enter" },
        { "waitFor": "#preview-root .region-name", "timeout": 120000 },

        { "eval": "document.querySelectorAll('#preview-root .report-title').length === 0" },
        { "eval": "Array.from(document.querySelectorAll('#preview-root [data-region-id]')).map(el => el.dataset.regionId).sort().join(',') === 'region_analysis,region_device_ranking,region_hourly_trend,region_total_energy'" },
        { "eval": "document.querySelector('#preview-root [data-region-id=\"region_data_quality\"]') === null" },
        { "eval": "document.querySelector('#preview-root [data-region-id=\"region_report_title\"]') === null" },
        { "eval": "Array.from(document.querySelectorAll('#preview-root .region-name')).map(el => el.textContent.trim()).join('|') === '总耗电|设备耗电排名|小时趋势|分析说明'" },
        { "eval": "!Array.from(document.querySelectorAll('#preview-root .region-name')).some(n => n.textContent.includes('昨日能耗日报'))" },
        { "assertText": "设备耗电排名" },

        { "assertHidden": "#preview-root .btn-del-region" },
        { "eval": "Array.from(document.querySelectorAll('#preview-root .region-tools')).every(t => t.offsetParent === null)" },
        { "eval": "!document.querySelector('#preview-root .report-name').hasAttribute('contenteditable')" },
        { "screenshot": "edit-tools-01-草稿态无编辑入口" },

        {
          "eval": "(() => { const sels = Array.from(document.querySelectorAll('.question-select')); const s = sels[sels.length - 1]; const opt = Array.from(s.options).find(o => o.textContent.trim() === '修改'); if (!opt) return false; s.value = opt.value; s.dispatchEvent(new Event('change', { bubbles: true })); return true; })()"
        },
        { "waitFor": "#preview-root .btn-del-region", "timeout": 30000 },
        { "eval": "Array.from(document.querySelectorAll('#preview-root .region-tools')).every(t => t.offsetParent !== null)" },
        { "eval": "document.querySelector('#preview-root .report-name').getAttribute('contenteditable') === 'true'" },
        { "eval": "Array.from(document.querySelectorAll('#preview-root .region-name')).every(n => n.getAttribute('contenteditable') === 'true')" },
        { "assertVisible": "#preview-root .btn-del-region" },
        { "screenshot": "edit-tools-02-选修改后出现编辑入口" }
      ]
    }
  ]
}
