# ========== Agent 实现选择 ==========
# fake:        默认，使用 FakeReportAgent（关键词规则）
# agentscope:  使用 AgentScopeReportAgent（火山方舟 LLM）
AGENT_IMPL=fake

# ========== 火山方舟 LLM 配置 ==========
# 直连 API Key（ark-xxx 开头）
VOLC_API_KEY=your-api-key-here

# 方舟 OpenAI 兼容 Base URL
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型名（可直接用模型名或 endpoint ID）
# 推荐：doubao-seed-2-1-lite-260915（免费额度友好）
# 省钱：doubao-1-5-pro-32k-250115
VOLC_MODEL=doubao-seed-2-1-lite-260915

# 模型调用参数
VOLC_TEMPERATURE=0.2
VOLC_TIMEOUT=30

# ContextEngine 两段式模型超时（关闭 SDK 自动重试后生效）
VOLC_CONTEXT_CONCIERGE_TIMEOUT=30
VOLC_CONTEXT_ROUTER_TIMEOUT=30

# ========== 可靠性 ==========
# 校验失败后修复重试次数（Q5：1）
LLM_REPAIR_RETRIES=1
