# ========== Agent 实现选择 ==========
# fake:        默认，使用 FakeReportAgent（关键词规则，不调模型）
# agentscope:  使用 AgentScopeReportAgent（真实模型）
AGENT_IMPL=fake

# ========== LLM Provider ==========
# 决定用哪家模型。当前默认 minimax。
# 显式切回火山方舟：改成 volcengine，其余走下面的 VOLC_*。
# **不自动回退**：provider 没配好就明确失败，不悄悄换一家继续跑。
LLM_PROVIDER=minimax

# ========== MiniMax LLM 配置 ==========
# 直连 API Key（sk- 开头）
MINIMAX_API_KEY=your-api-key-here

# OpenAI 兼容地址的 **API 根地址**（不要带 /chat/completions，SDK 自己拼）
MINIMAX_BASE_URL=https://api.minimax.cn/v1

# 模型名。当前选 MiniMax-M3：
#   - 强制 adaptive thinking，关不掉（thinking.type=disabled 会报 400）；
#   - 实测首字延迟高于「M3 + 关思考」，且思考会内联进 content 污染 JSON。
MINIMAX_MODEL=MiniMax-M3

# ========== 通用参数（覆盖上面任何一个 provider） ==========
# 温度
LLM_TEMPERATURE=0.2

# 短问答/接待员/路由器的单次调用超时（秒）
LLM_TIMEOUT=30

# 方案设计（完整 JSON）的单次调用超时（秒），必须大于 LLM_TIMEOUT
LLM_DESIGN_TIMEOUT=120

# ContextEngine 两段式模型超时（秒）
LLM_CONTEXT_CONCIERGE_TIMEOUT=30
LLM_CONTEXT_ROUTER_TIMEOUT=30

# 阶段模型覆盖：留空 = 跟随当前 provider 的默认模型
# LLM_CONTEXT_CONCIERGE_MODEL=
# LLM_CONTEXT_ROUTER_MODEL=
# LLM_DESIGN_MODEL=

# 通用覆盖：任何 provider 都吃，优先级最高（一般不用）
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ========== 火山方舟 LLM 配置 ==========
# 仅在 LLM_PROVIDER=volcengine 时生效（显式切回路径）
# 直连 API Key（ark-xxx 开头）
VOLC_API_KEY=your-api-key-here

# 方舟 OpenAI 兼容 Base URL（API 根地址）
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型名（可直接用模型名或 endpoint ID）
VOLC_MODEL=doubao-seed-2-1-lite-260915

# ========== 可靠性 ==========
# 校验失败后修复重试次数（Q5：1）
LLM_REPAIR_RETRIES=1
