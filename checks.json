{
  "serve": ".",
  "outDir": ".selfcheck",
  "waitMs": 1800,
  "ignore": ["modao.cc"],
  "pages": [
    {
      "name": "workbench",
      "path": "/frontend/pages/workbench.html",
      "title": "AI 报表生成工作台",
      "waitMs": 2500,
      "ignore": ["/health", "/api/sessions"],
      "selectors": [
        "h1",
        "#chat-input",
        "#btn-send",
        "#state-badge",
        "#footer-state",
        "#session-nav",
        "#session-list",
        "#session-search",
        "#preview-root",
        "#draft-badge",
        "[data-quick]",
        "#btn-regenerate"
      ],
      "texts": [
        "AI 报表助理",
        "机房能耗日报",
        "新建对话",
        "重新生成",
        "尚无草稿",
        "ANALYZING"
      ],
      "counts": [
        "#session-nav>=1",
        "#session-list>=1",
        "#chat-input>=1",
        "#btn-send>=1",
        "#state-badge>=1",
        "#preview-root>=1",
        "[data-quick]>=1"
      ]
    }
  ]
}
